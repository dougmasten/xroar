10 REM SDC COMMAND TIMING
20 CLEAR 200,&H4FFF
30 LOADM"SDCTIME":EXEC
40 OPEN "O",#1,"OUT.TXT"
50 CLS:PRINT"TEST       COUNT   USEC ST"
60 FOR I=0 TO 41
70 A=&H5000+I*3:C=PEEK(A)*256+PEEK(A+1):S=PEEK(A+2):READ N$
80 T=INT(C*18/.894886+.5)
90 L$=LEFT$(N$+"          ",10)+RIGHT$("      "+STR$(C),6)+RIGHT$("       "+STR$(T),7)+" "+RIGHT$("0"+HEX$(S),2)
100 PRINT#1,L$:PRINT L$
120 NEXT
130 CLOSE#1
150 DATA V,Q,I,RD 0,RD 0 AGAIN,RD 1,RD 2,RD 3,RD 300,RD 301,RD 18
160 DATA M ACCEPT,M DONE,N ACCEPT,N DONE
170 DATA WR0 ACC,WR0 DONE,WR0 ACC,WR0 DONE,WR0 ACC,WR0 DONE,WR0 ACC,WR0 DONE
180 DATA WR1 ACC,WR1 DONE,WR2 ACC,WR2 DONE,WR300 ACC,WR300 DONE
190 DATA RB 0,RB 300,L ACCEPT,L DONE,DIR PAGE
200 DATA STREAM 1,STREAM 2,STREAM 3,STREAM 4,STREAM 5,ABORT
210 DATA UNMNT ACC,UNMNT DONE
