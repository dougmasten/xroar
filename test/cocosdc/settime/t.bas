10 REM SDC DISK SET TIMING
20 CLEAR 200,&H4FFF
30 LOADM"SETTIME":EXEC
40 OPEN "O",#1,"OUT.TXT"
50 CLS:PRINT"TEST         COUNT     USEC ST"
60 FOR I=0 TO 24
70 A=&H5000+I*4:C=PEEK(A)*65536+PEEK(A+1)*256+PEEK(A+2):S=PEEK(A+3):READ N$
80 T=INT(C*18/.894886+.5)
90 L$=LEFT$(N$+"            ",12)+RIGHT$("       "+STR$(C),7)+RIGHT$("        "+STR$(T),9)+" "+RIGHT$("0"+HEX$(S),2)
100 PRINT#1,L$:PRINT L$
120 NEXT
130 N$="":FOR I=0 TO 10:N$=N$+CHR$(PEEK(&H5064+I)):NEXT
140 L$="AFTER #3: "+N$:PRINT#1,L$:PRINT L$
150 CLOSE#1
170 DATA I,K ACCEPT,K DONE,N 1 ACCEPT,N 1 DONE,N 2 ACCEPT,N 2 DONE,UNMNT ACC,UNMNT DONE
180 DATA SET ACCEPT,SET DONE,# 2,# 1,# 1 BLINK,# 2 BLINK,+ TO 1,+ TO 2,# 3 MISSING,I
190 DATA SET DRV1 ACC,SET DRV1 DON,N DIR ACC,N DIR DONE,REMOUNT ACC,REMOUNT DONE
