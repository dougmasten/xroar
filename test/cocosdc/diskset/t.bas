10 CLEAR 1000,&H4FFF:LOADM"SETCMD"
20 OPEN "O",#1,"OUT.TXT:1":DRIVE 0,"SET"
30 C$="-":N=0:POKE &H50F3,0:GOSUB 100
40 FOR I=1 TO 5:C$="+":N=0:GOSUB 90:NEXT
50 C$="#":N=3:GOSUB 90
60 C$="#":N=4:GOSUB 90
70 C$="#":N=9:GOSUB 90
80 CLOSE#1:END
90 POKE &H50F0,ASC(C$):POKE &H50F1,N:POKE &H50F2,0:EXEC &H5100
100 DSKI$ 0,17,3,A$,B$:L$=C$+STR$(N)+" ST"+STR$(PEEK(&H50F3))+" "+LEFT$(A$,2):PRINT#1,L$:PRINT L$
110 RETURN
