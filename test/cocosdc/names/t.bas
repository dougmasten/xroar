10 CLEAR 200,&H4FFF:LOADM"NM":OPEN "O",#1,"OUT.TXT"
20 READ C$,N$:IF C$="" THEN CLOSE#1:END
30 FOR I=0 TO 255:POKE &H5200+I,0:NEXT
40 FOR I=1 TO LEN(N$):POKE &H51FF+I,ASC(MID$(N$,I,1)):NEXT
50 POKE &H50F0,&HE0-(C$="1")
60 EXEC &H5100:S=PEEK(&H50F1):M$="":FOR I=0 TO 10:M$=M$+CHR$(PEEK(&H50F2+I)):NEXT
70 L$=LEFT$(N$+"                ",16)+RIGHT$("0"+HEX$(S),2)+" "+M$:PRINT#1,L$:PRINT L$
80 GOTO 20
