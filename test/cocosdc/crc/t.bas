10 CLEAR 200,&H4FFF:LOADM"RD":OPEN "O",#1,"OUT.TXT"
20 READ N$,L:IF N$="" THEN CLOSE#1:END
30 FOR I=0 TO 255:POKE &H5200+I,0:NEXT
40 FOR I=1 TO LEN(N$):POKE &H51FF+I,ASC(MID$(N$,I,1)):NEXT
45 POKE &H5300,0:POKE &H53FF,0
50 POKE &H50F8,0:POKE &H50F9,INT(L/256):POKE &H50FA,L AND 255
60 EXEC &H5100:L$=LEFT$(N$+"            ",12)+STR$(L):FOR I=0 TO 2:L$=L$+" "+RIGHT$("0"+HEX$(PEEK(&H50F0+I)),2):NEXT:L$=L$+" DATA "+HEX$(PEEK(&H5300))+" "+HEX$(PEEK(&H53FF))
70 PRINT#1,L$:PRINT L$:GOTO 20
100 DATA "M:E.SDF",0,"M:E.SDF",1,"M:E.SDF",2,"M:E.SDF",3,"M:E.SDF",40,"M:T.DSK",5
110 DATA "",0
