10 CLEAR 200,&H4FFF:LOADM"WT":OPEN "O",#1,"OUT.TXT"
20 READ N$:IF N$="" THEN CLOSE#1:END
30 FOR I=0 TO 255:POKE &H5200+I,0:NEXT
40 FOR I=1 TO LEN(N$):POKE &H51FF+I,ASC(MID$(N$,I,1)):NEXT
50 EXEC &H5100:L$=LEFT$(N$+"            ",12):FOR I=0 TO 3:L$=L$+" "+RIGHT$("0"+HEX$(PEEK(&H50F0+I)),2):NEXT
60 PRINT#1,L$:PRINT L$:GOTO 20
100 DATA "M:WP.SDF","M:RO.DSK","M:RW.DSK","m:RO.DSK","M:"
110 DATA ""
